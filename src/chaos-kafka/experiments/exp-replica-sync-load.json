{
  "version": "1.0.0",
  "title": "Validate Replica Sync Under Load",
  "description": "Sends a burst of messages to the booking-events topic and verifies that all Kafka replicas remain in sync.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events"
  },
  "steady-state-hypothesis": {
    "title": "All Kafka replicas are in sync",
    "probes": [
      {
        "type": "probe",
        "name": "check_all_replicas_in_sync_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "all_replicas_in_sync",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}"
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "produce_high_volume_messages",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "load-message-1", "load-message-2", "load-message-3", "load-message-4", "load-message-5",
            "load-message-6", "load-message-7", "load-message-8", "load-message-9", "load-message-10"
          ]
        }
      }
    },
    {
      "type": "probe",
      "name": "check_all_replicas_in_sync_after",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "all_replicas_in_sync",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}"
        }
      }
    }
  ],
  "rollbacks": []
}