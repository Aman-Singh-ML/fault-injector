{
  "version": "1.0.0",
  "title": "Booking Count Based Load Test - Reservation System",
  "description": "Generate exact number of bookings through Kafka to test booking pipeline performance with count-based control",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS",
      "default": "localhost:9093"
    },
    "topic": "booking-requests",
    "group_id": "booking-service-group",
    "booking_count": 100,
    "rate_per_second": 5,
    "user_id": null,
    "hotel_name_prefix": "Chaos Test Hotel",
    "price_min": 100.0,
    "price_max": 300.0,
    "stress_booking_count": 50,
    "concurrent_producers": 3,
    "user_id_min": 1,
    "user_id_max": 1000
  },
  "steady-state-hypothesis": {
    "title": "System can handle specified number of bookings efficiently",
    "probes": [
      {
        "type": "probe",
        "name": "check_kafka_topic_exists",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "topic_has_no_offline_partitions",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "topic": "${topic}"
          }
        }
      },
      {
        "type": "probe",
        "name": "check_consumer_lag_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "check_consumer_lag_under_threshold",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "group_id": "${group_id}",
            "topic": "${topic}",
            "threshold": 100
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "produce_baseline_bookings",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "{\"userId\": \"100\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-25\", \"checkOutDate\": \"2025-10-26\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}",
            "{\"userId\": \"101\", \"hotelId\": \"hotel_002\", \"hotelName\": \"Seaside Resort\", \"checkInDate\": \"2025-10-25\", \"checkOutDate\": \"2025-10-26\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 200.0}",
            "{\"userId\": \"102\", \"hotelId\": \"hotel_003\", \"hotelName\": \"Mountain View Lodge\", \"checkInDate\": \"2025-10-25\", \"checkOutDate\": \"2025-10-26\", \"rooms\": 2, \"adults\": 2, \"children\": 1, \"totalPrice\": 250.0}",
            "{\"userId\": \"103\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-26\", \"checkOutDate\": \"2025-10-27\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}",
            "{\"userId\": \"104\", \"hotelId\": \"hotel_002\", \"hotelName\": \"Seaside Resort\", \"checkInDate\": \"2025-10-26\", \"checkOutDate\": \"2025-10-27\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 200.0}"
          ]
        }
      },
      "pauses": {
        "after": 3
      }
    },
    {
      "type": "probe",
      "name": "check_consumer_lag_after_baseline",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "check_consumer_lag_under_threshold",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "threshold": 50
        }
      }
    },
    {
      "type": "action",
      "name": "produce_ramp_up_bookings",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "{\"userId\": \"110\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-27\", \"checkOutDate\": \"2025-10-28\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}",
            "{\"userId\": \"111\", \"hotelId\": \"hotel_002\", \"hotelName\": \"Seaside Resort\", \"checkInDate\": \"2025-10-27\", \"checkOutDate\": \"2025-10-28\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 200.0}",
            "{\"userId\": \"112\", \"hotelId\": \"hotel_003\", \"hotelName\": \"Mountain View Lodge\", \"checkInDate\": \"2025-10-27\", \"checkOutDate\": \"2025-10-28\", \"rooms\": 2, \"adults\": 2, \"children\": 1, \"totalPrice\": 250.0}",
            "{\"userId\": \"113\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-28\", \"checkOutDate\": \"2025-10-29\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}",
            "{\"userId\": \"114\", \"hotelId\": \"hotel_002\", \"hotelName\": \"Seaside Resort\", \"checkInDate\": \"2025-10-28\", \"checkOutDate\": \"2025-10-29\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 200.0}",
            "{\"userId\": \"115\", \"hotelId\": \"hotel_003\", \"hotelName\": \"Mountain View Lodge\", \"checkInDate\": \"2025-10-28\", \"checkOutDate\": \"2025-10-29\", \"rooms\": 2, \"adults\": 2, \"children\": 1, \"totalPrice\": 250.0}",
            "{\"userId\": \"116\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-29\", \"checkOutDate\": \"2025-10-30\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}",
            "{\"userId\": \"117\", \"hotelId\": \"hotel_002\", \"hotelName\": \"Seaside Resort\", \"checkInDate\": \"2025-10-29\", \"checkOutDate\": \"2025-10-30\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 200.0}",
            "{\"userId\": \"118\", \"hotelId\": \"hotel_003\", \"hotelName\": \"Mountain View Lodge\", \"checkInDate\": \"2025-10-29\", \"checkOutDate\": \"2025-10-30\", \"rooms\": 2, \"adults\": 2, \"children\": 1, \"totalPrice\": 250.0}",
            "{\"userId\": \"119\", \"hotelId\": \"hotel_001\", \"hotelName\": \"Grand Plaza Hotel\", \"checkInDate\": \"2025-10-30\", \"checkOutDate\": \"2025-10-31\", \"rooms\": 1, \"adults\": 2, \"children\": 0, \"totalPrice\": 150.0}"
          ]
        }
      },
      "pauses": {
        "after": 5
      }
    },
    {
      "type": "probe",
      "name": "check_consumer_lag_after_rampup",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "check_consumer_lag_under_threshold",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "threshold": 100
        }
      }
    }
  ],
  "rollbacks": [
  ]
}
