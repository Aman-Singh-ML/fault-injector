{
  "version": "1.0.0",
  "title": "Simulate Complete Kafka Topic Lifecycle with Faults",
  "description": "Run through Kafka topic lifecycle including consuming, rebalancing, and deletion for the notification-service while verifying system health.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events",
    "group_id": "notification-service"
  },
  "steady-state-hypothesis": {
    "title": "System is stable and healthy",
    "probes": [
      {
        "type": "probe",
        "name": "check_consumer_lag_initial",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "check_consumer_lag_under_threshold",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "group_id": "${group_id}",
            "topic": "${topic}",
            "threshold": 15
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "consume_messages",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "consume_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "timeout": 10000,
          "max_messages": 10
        }
      }
    },
    {
      "type": "probe",
      "name": "check_consumer_lag_midway",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "check_consumer_lag_under_threshold",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "threshold": 15
        }
      }
    },
    {
      "type": "action",
      "name": "rebalance_consumer_group",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "rebalance_consumer_group",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}"
        }
      }
    },
    {
      "type": "probe",
      "name": "check_replicas_in_sync_after_rebalance",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "all_replicas_in_sync",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}"
        }
      }
    },
    {
      "type": "action",
      "name": "delete_kafka_topic",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "delete_kafka_topic",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}"
        }
      }
    },
    {
      "type": "probe",
      "name": "check_cluster_health_final",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "cluster_doesnt_have_under_replicated_partitions",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}"
        }
      }
    }
  ],
  "rollbacks": []
}