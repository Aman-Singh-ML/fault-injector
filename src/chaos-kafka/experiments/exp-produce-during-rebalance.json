{
  "version": "1.0.0",
  "title": "Produce and Consume Messages During Consumer Rebalance",
  "description": "Tests if Kafka continues producing and consuming during consumer group rebalance for Reservation System.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events",
    "group_id": "notification-service",
    "threshold": 100
  },
  "steady-state-hypothesis": {
    "title": "Consumer lag remains under acceptable threshold",
    "probes": [
      {
        "type": "probe",
        "name": "check_consumer_lag_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "describe_consumer_groups",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "group_ids": ["${group_id}"]
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "produce_messages_during_rebalance",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "chaos-test-message-1",
            "chaos-test-message-2",
            "chaos-test-message-3"
          ]
        }
      }
    },
    {
      "type": "probe",
      "name": "consume_recent_messages",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "consume_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "partition": 0,
          "offset": 0,
          "num_messages": 3
        }
      }
    },
    {
      "type": "probe",
      "name": "check_consumer_lag_after",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "describe_consumer_groups",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_ids": ["${group_id}"]
        }
      }
    }
  ],
  "rollbacks": []
}