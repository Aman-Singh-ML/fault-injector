{
  "version": "1.0.0",
  "title": "Check Offline Partitions After Kafka Topic Deletion",
  "description": "Ensures no offline partitions remain after the booking-events Kafka topic is deleted.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events"
  },
  "steady-state-hypothesis": {
    "title": "Kafka topic deletion doesn't leave offline partitions",
    "probes": [
      {
        "type": "probe",
        "name": "check_no_offline_partitions_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "topic_has_no_offline_partitions",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "topic": "${topic}"
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "delete_kafka_topic",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "delete_kafka_topic",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}"
        }
      }
    },
    {
      "type": "probe",
      "name": "check_no_offline_partitions_after",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "topic_has_no_offline_partitions",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "log_rollback_placeholder",
      "provider": {
        "type": "python",
        "module": "chaostoolkit.logging",
        "func": "info",
        "arguments": {
          "message": "Rollback placeholder: Topic deletion is destructive; manual recreation required if needed."
        }
      }
    }
  ]
}