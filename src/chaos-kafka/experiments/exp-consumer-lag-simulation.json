{
  "version": "1.0.0",
  "title": "Kafka Consumer Lag Simulation - Booking Events",
  "description": "Produces and consumes messages on the booking-events topic, simulating consumer delay and verifying lag stays within threshold.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "group_id": "notification-service",
    "topic": "booking-events"
  },
  "steady-state-hypothesis": {
    "title": "Consumer lag is under acceptable threshold",
    "probes": [
      {
        "type": "probe",
        "name": "check_consumer_lag_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "check_consumer_lag_under_threshold",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "group_id": "${group_id}",
            "topic": "${topic}",
            "threshold": 15
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "produce_test_messages",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "booking-event-1",
            "booking-event-2",
            "booking-event-3",
            "booking-event-4",
            "booking-event-5"
          ]
        }
      }
    },
    {
      "type": "action",
      "name": "consume_messages_with_delay",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "consume_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "partition": 0,
          "offset": 0,
          "num_messages": 2
        }
      }
    },
    {
      "type": "probe",
      "name": "check_consumer_lag_after",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "check_consumer_lag_under_threshold",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}",
          "topic": "${topic}",
          "threshold": 15
        }
      }
    }
  ],
  "rollbacks": []
}