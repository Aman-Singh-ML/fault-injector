{
  "version": "1.0.0",
  "title": "Delete and Restore Kafka Topic Experiment - Reservation System",
  "description": "Simulates accidental deletion of Kafka topic 'booking-events' and validates recovery using Chaos Toolkit Kafka driver.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events"
  },
  "steady-state-hypothesis": {
    "title": "Kafka topic exists before deletion",
    "probes": [
      {
        "type": "probe",
        "name": "check_topic_exists_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "describe_kafka_topic",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "topic": "${topic}"
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "delete_booking_topic",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "delete_kafka_topic",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}"
        }
      }
    },
    {
      "type": "probe",
      "name": "verify_topic_deleted",
      "tolerance": false,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "describe_kafka_topic",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "recreate_booking_topic",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "create_kafka_topic",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "partitions": 3,
          "replication_factor": 1
        }
      }
    }
  ]
}