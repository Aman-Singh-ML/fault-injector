{
  "version": "1.0.0",
  "title": "Delete Consumer Group and Observe Recovery",
  "description": "Deletes the 'notification-service' Kafka consumer group (booking-events topic) and verifies that the Kafka cluster remains healthy and the topic stays accessible.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events",
    "group_id": "notification-service"
  },
  "steady-state-hypothesis": {
    "title": "Kafka topic is accessible and cluster is healthy",
    "probes": [
      {
        "type": "probe",
        "name": "describe_kafka_topic",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "describe_kafka_topic",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}",
            "topic": "${topic}"
          }
        }
      },
      {
        "type": "probe",
        "name": "check_no_under_replicated_partitions",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "cluster_doesnt_have_under_replicated_partitions",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}"
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "delete_consumer_group",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "delete_consumer_group",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "group_id": "${group_id}"
        }
      },
      "pauses": {
        "after": 15
      }
    },
    {
      "type": "probe",
      "name": "verify_cluster_after_delete",
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "cluster_doesnt_have_under_replicated_partitions",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "restart_notification_service",
      "provider": {
        "type": "process",
        "path": "systemctl",
        "arguments": [
          "restart",
          "notification-service"
        ]
      }
    }
  ]
}