{
  "version": "1.0.0",
  "title": "Stress Kafka with High Volume Message Production",
  "description": "Sends a large number of messages to Kafka to verify the cluster remains healthy and the booking-events topic is stable.",
  "configuration": {
    "bootstrap_servers": {
      "type": "env",
      "key": "BOOTSTRAP_SERVERS"
    },
    "topic": "booking-events",
    "group_id": "notification-service"
  },
  "steady-state-hypothesis": {
    "title": "Kafka cluster remains healthy (no under-replicated partitions)",
    "probes": [
      {
        "type": "probe",
        "name": "check_cluster_health_before",
        "tolerance": true,
        "provider": {
          "type": "python",
          "module": "chaoskafka.probes",
          "func": "cluster_doesnt_have_under_replicated_partitions",
          "arguments": {
            "bootstrap_servers": "${bootstrap_servers}"
          }
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "produce_high_volume_messages",
      "provider": {
        "type": "python",
        "module": "chaoskafka.actions",
        "func": "produce_messages",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}",
          "topic": "${topic}",
          "messages": [
            "message-1","message-2","message-3","message-4","message-5",
            "message-6","message-7","message-8","message-9","message-10",
            "message-11","message-12","message-13","message-14","message-15",
            "message-16","message-17","message-18","message-19","message-20",
            "message-21","message-22","message-23","message-24","message-25",
            "message-26","message-27","message-28","message-29","message-30",
            "message-31","message-32","message-33","message-34","message-35",
            "message-36","message-37","message-38","message-39","message-40",
            "message-41","message-42","message-43","message-44","message-45",
            "message-46","message-47","message-48","message-49","message-50"
          ]
        }
      }
    },
    {
      "type": "probe",
      "name": "check_cluster_health_after",
      "tolerance": true,
      "provider": {
        "type": "python",
        "module": "chaoskafka.probes",
        "func": "cluster_doesnt_have_under_replicated_partitions",
        "arguments": {
          "bootstrap_servers": "${bootstrap_servers}"
        }
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "log_rollback_action",
      "provider": {
        "type": "python",
        "module": "chaostoolkit.logging",
        "func": "info",
        "arguments": {
          "message": "Rollback placeholder: No rollback defined for high-volume message stress test."
        }
      }
    }
  ]
}