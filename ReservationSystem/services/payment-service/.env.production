# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin@rabbitmq.hotel-reservation.svc.cluster.local:5672/
RABBITMQ_QUEUE=payment_notifications

# PostgreSQL Configuration - Isolated Payment Database
POSTGRES_URL=postgresql://payment_user:payment_pass@postgres-payment.hotel-reservation.svc.cluster.local:5432/payment_db
DB_HOST=postgres-payment.hotel-reservation.svc.cluster.local
DB_PORT=5432
DB_USER=payment_user
DB_PASSWORD=payment_pass
DB_NAME=payment_db

# Redis Configuration
REDIS_ADDR=redis-payment.hotel-reservation.svc.cluster.local:6379

# Server Configuration
PORT=8082
HOST=0.0.0.0

