# PostgreSQL Configuration - Isolated Booking Database
DATABASE_URL=postgresql://booking_user:booking_pass@postgres-booking.hotel-reservation.svc.cluster.local:5432/booking_db
DB_HOST=postgres-booking.hotel-reservation.svc.cluster.local
DB_PORT=5432
DB_USER=booking_user
DB_PASSWORD=booking_pass
DB_NAME=booking_db

# Redis Configuration
REDIS_HOST=redis-booking.hotel-reservation.svc.cluster.local
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka.hotel-reservation.svc.cluster.local:9092
KAFKA_TOPIC=booking-events

# Server Configuration
PORT=8000
HOST=0.0.0.0

