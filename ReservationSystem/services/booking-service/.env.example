# PostgreSQL Configuration - Isolated Booking Database
DATABASE_URL=postgresql://booking_user:booking_pass@localhost:5433/booking_db
DB_HOST=localhost
DB_PORT=5433
DB_USER=booking_user
DB_PASSWORD=booking_pass
DB_NAME=booking_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC=booking-events

# Server Configuration
PORT=8000
HOST=0.0.0.0

