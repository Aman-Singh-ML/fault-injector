# MongoDB Configuration
MONGO_URI=mongodb://admin:admin@mongo.hotel-reservation.svc.cluster.local:27017
MONGO_DATABASE=hotel_db

# Redis Configuration
REDIS_HOST=redis-notification.hotel-reservation.svc.cluster.local
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka.hotel-reservation.svc.cluster.local:9092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin@rabbitmq.hotel-reservation.svc.cluster.local:5672/
RABBITMQ_QUEUE=booking_notifications

# SMTP Configuration (Optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@hotel.com

# Server Configuration
PORT=8083
HOST=0.0.0.0

