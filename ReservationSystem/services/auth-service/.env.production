# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-auth.hotel-reservation.svc.cluster.local:5432/auth_db
SPRING_DATASOURCE_USERNAME=auth_user
SPRING_DATASOURCE_PASSWORD=auth_pass
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Redis Configuration
REDIS_HOST=redis-auth.hotel-reservation.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidation123456789
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

