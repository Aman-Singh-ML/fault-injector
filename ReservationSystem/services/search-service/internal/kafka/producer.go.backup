package kafka

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log"
	"os"
	"strings"
	"time"

	"github.com/segmentio/kafka-go"
)

type BookingRequest struct {
	UserID       string  `json:"userId"`
	HotelID      string  `json:"hotelId"`
	HotelName    string  `json:"hotelName"`
	CheckInDate  string  `json:"checkInDate"`
	CheckOutDate string  `json:"checkOutDate"`
	Rooms        int     `json:"rooms"`
	Adults       int     `json:"adults"`
	Children     int     `json:"children"`
	TotalPrice   float64 `json:"totalPrice"`
}

var (
	writer        *kafka.Writer
	kafkaBrokers  []string
	kafkaTopic    = "booking-requests"
	retryInterval = 5 * time.Second

	// Notification Kafka (general broker)
	notifWriter        *kafka.Writer
	notifBrokers       []string
	notifTopic         = "booking-events"
	notifRetryInterval = 5 * time.Second
)

// KafkaError defines structured Kafka error
type KafkaError struct {
	Code    string `json:"code"`
	Message string `json:"message"`
	Detail  string `json:"detail,omitempty"`
}

func (e *KafkaError) Error() string {
	return fmt.Sprintf("%s: %s", e.Code, e.Message)
}

// InitProducer initializes Kafka writers and starts auto-reconnects
func InitProducer() error {
	// Booking Kafka (dedicated broker for booking-requests)
	servers := os.Getenv("KAFKA_BOOKING_SERVERS")
	if servers == "" {
		servers = "localhost:9094"
	}
	kafkaBrokers = strings.Split(servers, ",")

	// Notification Kafka (general broker for booking-events)
	notifServers := os.Getenv("KAFKA_BOOTSTRAP_SERVERS")
	if notifServers == "" {
		notifServers = "localhost:9092"
	}
	notifBrokers = strings.Split(notifServers, ",")

	go monitorKafkaConnection()             // Background reconnection for booking writer
	go monitorNotificationKafkaConnection() // Background reconnection for notification writer

	return nil
}

// monitorKafkaConnection continuously tries to connect to Kafka
func monitorKafkaConnection() {
	for {
		if writer == nil {
			log.Println("🔄 Attempting to initialize Kafka producer...")
			err := createProducer()
			if err != nil {
				log.Printf("⚠️ Kafka not ready yet: %v", err)
			} else {
				log.Println("✅ Kafka producer connected successfully.")
			}
		}
		time.Sleep(retryInterval)
	}
}

// createProducer initializes writer (assumes topic already exists)
func createProducer() error {
	// Test connection
	conn, err := kafka.Dial("tcp", kafkaBrokers[0])
	if err != nil {
		return fmt.Errorf("failed to connect to Kafka broker: %w", err)
	}
	conn.Close()

	// Create writer (topic should already exist)
	writer = &kafka.Writer{
		Addr:         kafka.TCP(kafkaBrokers...),
		Topic:        kafkaTopic,
		Balancer:     &kafka.LeastBytes{},
		RequiredAcks: kafka.RequireAll,
		BatchTimeout: 1 * time.Second,
		Async:        false,
	}
	return nil
}

// PublishBookingRequest publishes message with error awareness
func PublishBookingRequest(booking BookingRequest) error {
	if writer == nil {
		return &KafkaError{Code: "KAFKA_NOT_CONNECTED", Message: "Kafka producer not connected yet"}
	}

	data, err := json.Marshal(booking)
	if err != nil {
		return &KafkaError{Code: "INVALID_DATA", Message: "Failed to serialize booking", Detail: err.Error()}
	}

	msg := kafka.Message{
		Key:   []byte(booking.UserID),
		Value: data,
		Time:  time.Now(),
	}

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	for attempt := 1; attempt <= 3; attempt++ {
		err = writer.WriteMessages(ctx, msg)
		if err == nil {
			log.Printf("📨 Kafka publish success (attempt %d): User=%s, Hotel=%s", attempt, booking.UserID, booking.HotelID)
			return nil
		}

		// handle errors gracefully
		if errors.Is(err, context.DeadlineExceeded) {
			return &KafkaError{Code: "KAFKA_TIMEOUT", Message: "Kafka write timed out"}
		}
		if strings.Contains(err.Error(), "leader not available") {
			return &KafkaError{Code: "KAFKA_LEADER_NOT_AVAILABLE", Message: "Kafka leader not available"}
		}
		if strings.Contains(err.Error(), "unknown topic or partition") {
			writer = nil
			return &KafkaError{Code: "KAFKA_TOPIC_NOT_FOUND", Message: "Kafka topic not found", Detail: err.Error()}
		}

		log.Printf("⚠️ Kafka publish attempt %d failed: %v (retrying...)", attempt, err)
		time.Sleep(time.Second * 2)
	}

	writer = nil
	return &KafkaError{Code: "KAFKA_PUBLISH_FAILED", Message: "Failed to publish after retries", Detail: err.Error()}
}

// monitorNotificationKafkaConnection continuously tries to connect to Notification Kafka
func monitorNotificationKafkaConnection() {
	for {
		if notifWriter == nil {
			log.Println("🔄 Attempting to initialize Notification Kafka producer...")
			err := createNotificationProducer()
			if err != nil {
				log.Printf("⚠️ Notification Kafka not ready yet: %v", err)
			} else {
				log.Println("✅ Notification Kafka producer connected successfully.")
			}
		}
		time.Sleep(notifRetryInterval)
	}
}

// createNotificationProducer initializes notification writer (assumes topic already exists)
func createNotificationProducer() error {
	// Test connection
	conn, err := kafka.Dial("tcp", notifBrokers[0])
	if err != nil {
		return fmt.Errorf("failed to connect to Notification Kafka broker: %w", err)
	}
	conn.Close()

	// Create writer (topic should already exist)
	notifWriter = &kafka.Writer{
		Addr:         kafka.TCP(notifBrokers...),
		Topic:        notifTopic,
		Balancer:     &kafka.LeastBytes{},
		RequiredAcks: kafka.RequireAll,
		BatchTimeout: 1 * time.Second,
		Async:        false,
	}
	return nil
}

// PublishBookingStartedNotification publishes a non-critical notification event
func PublishBookingStartedNotification(booking BookingRequest) error {
	if notifWriter == nil {
		return &KafkaError{Code: "KAFKA_NOT_CONNECTED", Message: "Notification Kafka producer not connected yet"}
	}

	// Calculate number of days
	checkIn, _ := time.Parse("2006-01-02", booking.CheckInDate)
	checkOut, _ := time.Parse("2006-01-02", booking.CheckOutDate)
	days := int(checkOut.Sub(checkIn).Hours() / 24)

	event := map[string]interface{}{
		"eventType": "BOOKING_CREATION_STARTED",
		"data": map[string]interface{}{
			"userId":       booking.UserID,
			"hotelId":      booking.HotelID,
			"hotelName":    booking.HotelName,
			"checkInDate":  booking.CheckInDate,
			"checkOutDate": booking.CheckOutDate,
			"rooms":        booking.Rooms,
			"adults":       booking.Adults,
			"children":     booking.Children,
			"totalPrice":   booking.TotalPrice,
			"days":         days,
			"timestamp":    time.Now().UTC().Format(time.RFC3339Nano),
		},
	}

	data, err := json.Marshal(event)
	if err != nil {
		return &KafkaError{Code: "INVALID_DATA", Message: "Failed to serialize notification", Detail: err.Error()}
	}

	msg := kafka.Message{
		Key:   []byte(booking.UserID),
		Value: data,
		Time:  time.Now(),
	}

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	var lastErr error
	for attempt := 1; attempt <= 3; attempt++ {
		lastErr = notifWriter.WriteMessages(ctx, msg)
		if lastErr == nil {
			log.Printf("📨 Notification publish success (attempt %d): User=%s, Hotel=%s", attempt, booking.UserID, booking.HotelID)
			return nil
		}

		if errors.Is(lastErr, context.DeadlineExceeded) {
			return &KafkaError{Code: "KAFKA_TIMEOUT", Message: "Notification Kafka write timed out"}
		}
		if strings.Contains(lastErr.Error(), "leader not available") {
			return &KafkaError{Code: "KAFKA_LEADER_NOT_AVAILABLE", Message: "Notification Kafka leader not available"}
		}
		if strings.Contains(lastErr.Error(), "unknown topic or partition") {
			notifWriter = nil
			return &KafkaError{Code: "KAFKA_TOPIC_NOT_FOUND", Message: "Notification topic not found", Detail: lastErr.Error()}
		}

		log.Printf("⚠️ Notification publish attempt %d failed: %v (retrying...)", attempt, lastErr)
		time.Sleep(2 * time.Second)
	}

	notifWriter = nil
	return &KafkaError{Code: "KAFKA_PUBLISH_FAILED", Message: "Failed to publish notification after retries", Detail: lastErr.Error()}
}

// CloseProducer safely closes Kafka writers
func CloseProducer() error {
	var firstErr error
	if writer != nil {
		log.Println("🧹 Closing Kafka producer (booking)...")
		if err := writer.Close(); err != nil && firstErr == nil {
			firstErr = err
		}
		writer = nil
	}
	if notifWriter != nil {
		log.Println("🧹 Closing Kafka producer (notification)...")
		if err := notifWriter.Close(); err != nil && firstErr == nil {
			firstErr = err
		}
		notifWriter = nil
	}
	return firstErr
}
