PORT=9000
NODE_ENV=production

# Service URLs - Using Kubernetes DNS names
AUTH_SERVICE_URL=http://auth-service.hotel-reservation.svc.cluster.local:8080
SEARCH_SERVICE_URL=http://search-service.hotel-reservation.svc.cluster.local:8081
BOOKING_SERVICE_URL=http://booking-service.hotel-reservation.svc.cluster.local:8000
PAYMENT_SERVICE_URL=http://payment-service.hotel-reservation.svc.cluster.local:8082
NOTIFICATION_SERVICE_URL=http://notification-service.hotel-reservation.svc.cluster.local:8083

# Database Configuration - Auth Service (Isolated)
DB_HOST=postgres-auth.hotel-reservation.svc.cluster.local
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass
DB_NAME=auth_db

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidation123456789

# Frontend URL
FRONTEND_URL=http://frontend.hotel-reservation.svc.cluster.local:3000

